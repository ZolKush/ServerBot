# Telegram token from BotFather.
BOT_TOKEN=

# Generated administrator-only password, at least 16 characters.
# Ordinary users request access in the bot and do not use this password.
ADMIN_PASSWORD=

# Separate one-time claim password for the only service manager.
# Must differ from ADMIN_PASSWORD and contain at least 16 characters.
OWNER_PASSWORD=

# Optional HTTP Basic credentials for REMNAWAVE_METRICS_URL.
# Leave both empty when the metrics endpoint does not require authentication.
REMNAWAVE_METRICS_USER=
REMNAWAVE_METRICS_PASS=
