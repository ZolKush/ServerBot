TZ=Europe/Moscow
LOG_LEVEL=INFO
LOG_JSON=false
USER_DATA_PATH=/opt/maintbot/data/user_data.json
IMPORTANT_DATA_PATH=/opt/maintbot/data/important_data.json

# Local server where the bot process is running.
LOCAL_SERVER_CODE=nl
LOCAL_SERVER_LABEL=Netherlands(Bot)
LOCAL_SERVER_FLAG=NL
MONITOR_CONTAINERS=remnanode,remnawave-nginx
EXPECTED_A_IP=203.0.113.20
CHECK_A_DOMAINS=nl.example.com

# Shared checks.
DNS_RESOLVERS=1.1.1.1,8.8.8.8
SUBPROC_SHORT_TIMEOUT=3
SUBPROC_MEDIUM_TIMEOUT=8
FAIL2BAN_LOG_PATH=/var/log/fail2ban.log
FAIL2BAN_DAILY_AT=12:00
DNS_DAILY_REFRESH_AT=03:05
DNS_STARTUP_REFRESH_DELAY_SEC=5
MAINT_RESTART_NOTIFY_DELAY_SEC=2

# Remote servers. Values must be in the same order.
REMOTE_SERVER_ENABLED=true
REMOTE_SERVER_CODES=main,ru1,ru2
REMOTE_SERVER_LABELS=Russia(Main),Russia(S1),Russia(S2)
REMOTE_SERVER_FLAGS=RU,RU,RU
REMOTE_SERVER_SSH_TARGETS=maintbot@203.0.113.10:1606,maintbot@203.0.113.11:1606,maintbot@203.0.113.12:1606
REMOTE_SERVER_EXPECTED_A_IPS=203.0.113.10,203.0.113.11,203.0.113.12

# One domain per remote server:
# REMOTE_SERVER_DOMAINS=main.example.com,ru1.example.com,ru2.example.com
#
# Or multiple domains per server. Use semicolon between servers and comma inside a server group:
REMOTE_SERVER_DOMAINS=xvui.ittelecom.pl,supsub.ittelecom.pl;ru1.example.com;ru2.example.com

# Same path on every remote server.
REMOTE_SERVER_FAIL2BAN_LOG_PATH=/var/log/fail2ban.log

# Fallback container list for all remote servers.
REMOTE_SERVER_MONITOR_CONTAINERS=remnanode,remnawave-nginx

# Optional per-remote-server container groups. Use semicolon between servers.
# This overrides REMOTE_SERVER_MONITOR_CONTAINERS for each remote server by order.
REMOTE_SERVER_MONITOR_CONTAINERS_BY_SERVER=remnawave,remnawave-db,remnawave-redis,remnanode,remnawave-nginx,remnawave-subscription-page;remnanode,remnawave-nginx;remnanode,remnawave-nginx

# Legacy single-remote-server settings are still supported:
# REMOTE_SERVER_CODE=de
# REMOTE_SERVER_LABEL=Germany
# REMOTE_SERVER_FLAG=DE
# REMOTE_SERVER_SSH_TARGET=maintbot@203.0.113.10:1606
# REMOTE_SERVER_EXPECTED_A_IP=203.0.113.10
# REMOTE_SERVER_CHECK_A_DOMAINS=de.example.com
