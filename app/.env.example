# General settings. ENV_PATH and SECRETS_ENV_PATH must be exported by the
# process before startup when non-default files are used.
TZ=Europe/Moscow
LOG_LEVEL=INFO
LOG_JSON=false

# Runtime state. Keep this directory writable only by the maintbot account.
USER_DATA_PATH=/opt/maintbot/data/user_data.json
IMPORTANT_DATA_PATH=/opt/maintbot/data/important_data.json
CONFIG_PATH=/opt/maintbot/data/config.json
PTB_PERSISTENCE_PATH=/opt/maintbot/data/ptb_persistence
INSTANCE_LOCK_PATH=/run/maintbot/maintbot.lock

# Authentication protection. Ordinary users do not have a shared password:
# they send an access request that an administrator approves in the bot.
AUTH_FAIL_WINDOW_SEC=300
AUTH_MAX_FAILS_IN_WINDOW=5
AUTH_GLOBAL_MAX_FAILS_IN_WINDOW=40
AUTH_LOCKOUT_SEC=600
AUTH_PRUNE_INTERVAL_SEC=300
ACCESS_REQUEST_COOLDOWN_SEC=300
ERROR_NOTIFY_INTERVAL_SEC=300
OUTBOX_PROCESS_INTERVAL_SEC=10

# Local server where the bot process runs.
LOCAL_SERVER_CODE=local
LOCAL_SERVER_LABEL=Local server
LOCAL_SERVER_FLAG=
MONITOR_CONTAINERS=
EXPECTED_A_IP=
CHECK_A_DOMAINS=

# DNS, subprocesses and cached status.
DNS_RESOLVERS=1.1.1.1,8.8.8.8,77.88.8.8
DNS_DAILY_REFRESH_AT=03:05
DNS_STARTUP_REFRESH_DELAY_SEC=5
SUBPROC_SHORT_TIMEOUT=3
SUBPROC_MEDIUM_TIMEOUT=8
SUBPROC_MAX_OUTPUT_BYTES=1000000
STATUS_CACHE_TTL_SEC=5

# Local fail2ban. The path must also be listed in
# /etc/maintbot/fail2ban-paths for privileged reads.
FAIL2BAN_ENABLED=true
FAIL2BAN_LOG_PATH=/var/log/fail2ban.log
FAIL2BAN_TIMEZONE=Europe/Moscow
FAIL2BAN_DAILY_AT=12:00
FAIL2BAN_DIGEST_TAIL_LINES=20000
FAIL2BAN_DIGEST_MAX_BYTES=3000000

# Maintenance reminders.
MAINT_RESTART_NOTIFY_DELAY_SEC=2
MAINT_RESTART_REMINDER_INTERVAL_SEC=1800

# Dedicated SSH key and a pre-verified known_hosts file are mandatory whenever
# a remote server is enabled. Production config_check accepts only "yes".
SSH_STRICT_HOST_KEY_CHECKING=yes
SSH_IDENTITY_FILE=/etc/maintbot/ssh/id_ed25519
SSH_KNOWN_HOSTS_FILE=/etc/maintbot/ssh/known_hosts
PRIVILEGED_HELPER_BIN=/usr/local/libexec/maintbot-helper

# Remote servers. Every non-empty plural list below must follow exactly the
# order and count of REMOTE_SERVER_SSH_TARGETS. Separate server-specific domain
# or container groups with semicolons.
REMOTE_SERVER_ENABLED=false
REMOTE_SERVER_SSH_TARGETS=maintbot@server-one.example:22,maintbot@server-two.example:22
REMOTE_SERVER_CODES=one,two
REMOTE_SERVER_LABELS=Server One,Server Two
REMOTE_SERVER_FLAGS=DE,NL
REMOTE_SERVER_EXPECTED_A_IPS=192.0.2.10,192.0.2.20
REMOTE_SERVER_DOMAINS=one.example.com,api.one.example.com;two.example.com
REMOTE_SERVER_MONITOR_CONTAINERS=remnanode,remnawave-nginx
REMOTE_SERVER_MONITOR_CONTAINERS_BY_SERVER=remnawave,remnawave-db;remnanode,remnawave-nginx
REMOTE_SERVER_FAIL2BAN_LOG_PATH=/var/log/fail2ban.log
REMOTE_SERVER_FAIL2BAN_LOG_PATHS=/var/log/fail2ban.log,/var/log/fail2ban.log
REMOTE_SERVER_FAIL2BAN_ENABLED=true,true
REMOTE_SERVER_FAIL2BAN_TIMEZONES=Europe/Berlin,Europe/Amsterdam

# Legacy settings for one remote server remain supported. Prefer plural fields.
# REMOTE_SERVER_SSH_TARGET=maintbot@server.example:22
# REMOTE_SERVER_CODE=remote
# REMOTE_SERVER_LABEL=Remote server
# REMOTE_SERVER_FLAG=DE
# REMOTE_SERVER_EXPECTED_A_IP=192.0.2.10
# REMOTE_SERVER_CHECK_A_DOMAINS=server.example.com

# Status mode: ssh, or mixed when RemnaWave metrics are available.
BOT_MODE=ssh
REMNAWAVE_METRICS_URL=
REMNAWAVE_METRICS_USER=
REMNAWAVE_METRICS_PASS=
REMNAWAVE_METRICS_TIMEOUT_SEC=3
REMNAWAVE_METRICS_CACHE_TTL_SEC=8
REMNAWAVE_METRICS_MAX_BYTES=2000000
REMNAWAVE_HIDDEN_UUIDS=
LOCAL_SERVER_REMNAWAVE_UUID=
# Keep empty positions when only some remote servers have a UUID.
REMOTE_SERVER_REMNAWAVE_UUIDS=
DAILY_NODE_STATUS_REFRESH_AT=12:00
