{
  "version": 1,
  "key": "nl",
  "label": "Netherlands",
  "flag": "NL",
  "display_order": 20,
  "connection": {
    "transport": "ssh",
    "target": "maintbot@server-nl.example:1606"
  },
  "monitoring": {
    "source": "remnawave",
    "node_uuid": "00000000-0000-0000-0000-000000000001"
  },
  "dns": {
    "expected_a_ip": "192.0.2.20"
  },
  "domains": [
    {
      "host": "nextfiles.example.com",
      "checks": ["dns", "tls"],
      "tls_primary_port": 443,
      "tls_fallback_ports": []
    },
    {
      "host": "tls-fallback.example.com",
      "checks": ["dns", "tls"],
      "tls_primary_port": 443,
      "tls_fallback_ports": [8443]
    }
  ],
  "docker": {
    "containers": ["remnanode", "remnawave-nginx"]
  },
  "fail2ban": {
    "enabled": true,
    "log_path": "/var/log/fail2ban.log",
    "timezone": "Europe/Amsterdam"
  }
}
