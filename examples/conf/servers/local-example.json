{
  "version": 1,
  "key": "local",
  "label": "Example local server",
  "flag": "",
  "display_order": 10,
  "connection": {
    "transport": "local",
    "target": ""
  },
  "monitoring": {
    "source": "system",
    "node_uuid": ""
  },
  "dns": {
    "expected_a_ip": "192.0.2.10"
  },
